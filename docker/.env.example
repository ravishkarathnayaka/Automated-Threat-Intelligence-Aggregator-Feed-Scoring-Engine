# =====================================================================
# Threat Intelligence Scoring Engine - Environment Configuration
# =====================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=cti_admin
POSTGRES_PASSWORD=cti_secure_pass123
POSTGRES_DB=cti_scoring_db
POSTGRES_PORT=5432

# Redis Cache Configuration
REDIS_PORT=6379

# External Threat Intelligence API Keys (Optional - System defaults to synthetic mock feeds if empty)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
OTX_API_KEY=your_alienvault_otx_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Pipeline Settings
OFFLINE_MODE=false
SYNC_INTERVAL_SECONDS=3600
